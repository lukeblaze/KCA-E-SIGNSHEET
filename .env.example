# Copy to .env (bin/setup.php does this for you and generates APP_SECRET)
APP_ENV=dev                 # dev | prod  (prod disables the mock portal and demo hints)
APP_SECRET=                 # long random string; signs the audit log chain
TZ=Africa/Nairobi
VERIFY_BASE_URL=http://localhost:8080
# Only these exact domains are accepted for student email copies
ALLOWED_EMAIL_DOMAINS=students.kcau.ac.ke,students.kca.ac.ke
STAFF_EMAIL_DOMAIN=kcau.ac.ke  # staff must sign in with name@this-domain
MX_CHECK=0                  # 1 = also require the email domain to have MX records
# Mail: outbox (writes .eml files to storage/outbox) | smtp
MAIL_MODE=outbox
MAIL_FROM=esign@kcau.ac.ke
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls             # tls | ssl | none
SMTP_USER=
SMTP_PASS=
# Portal: mock (data/mock_portal.json) | http (src/Portal/HttpPortal.php, needs KCA ICT endpoints)
PORTAL_DRIVER=mock
PORTAL_API_URL=
PORTAL_API_TOKEN=
